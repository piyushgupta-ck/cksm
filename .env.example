# ─────────────────────────────────────────────────────────────────────────────
# CKSM Environment Configuration
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite)
DATABASE_URL=sqlite:///cksm.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://cksm_user:strong_password@localhost:5432/cksm_db

# ── Outbound Mail (SMTP) ──────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=noreply@citykart.com

# ── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216

# ── Background Scheduler ─────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SLA_CHECK_INTERVAL_MINUTES=5

# ── Email-to-Ticket (Inbound IMAP) ───────────────────────────────────────────
IMAP_ENABLED=false
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USERNAME=support@citykart.com
IMAP_PASSWORD=your-imap-app-password
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_MINUTES=5
IMAP_DEFAULT_DEPT=IT
IMAP_DEFAULT_PRIORITY=Medium

# ── Gunicorn (production / self-hosted) ──────────────────────────────────────
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4
GUNICORN_ACCESS_LOG=logs/access.log
GUNICORN_ERROR_LOG=logs/error.log
GUNICORN_LOG_LEVEL=info

# ── Railway deployment ────────────────────────────────────────────────────────
# On Railway, do NOT set PORT or DATABASE_URL here — Railway injects them.
# Set only these in the Railway dashboard → Variables:
#
#   SECRET_KEY          = <long random string>
#   FLASK_ENV           = production
#   GUNICORN_WORKERS    = 1   ← required when IMAP_ENABLED=true (scheduler)
#   MAIL_SERVER         = smtp.gmail.com
#   MAIL_PORT           = 587
#   MAIL_USE_TLS        = true
#   MAIL_USERNAME       = your-email@gmail.com
#   MAIL_PASSWORD       = your-gmail-app-password
#   MAIL_DEFAULT_SENDER = noreply@yourdomain.com
#   IMAP_ENABLED        = false   (or true + IMAP_* vars if needed)
#
# Add the Railway PostgreSQL plugin — it auto-sets DATABASE_URL.
