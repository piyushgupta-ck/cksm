# ─────────────────────────────────────────────────────────────────────────────
# Nginx reverse-proxy config for CKSM
# Place in /etc/nginx/sites-available/cksm and symlink to sites-enabled/
# Replace YOUR_DOMAIN with your actual domain or server IP.
# ─────────────────────────────────────────────────────────────────────────────

upstream cksm_app {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name YOUR_DOMAIN;

    # Redirect HTTP → HTTPS (uncomment when SSL is set up)
    # return 301 https://$host$request_uri;

    client_max_body_size 20M;

    # Static files served directly by Nginx (faster than Flask)
    location /static/ {
        alias /path/to/cksm/app/static/;
        expires 7d;
        access_log off;
    }

    # Everything else → Gunicorn
    location / {
        proxy_pass         http://cksm_app;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

